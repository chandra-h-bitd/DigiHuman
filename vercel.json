{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist/docqa-spa"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "frontend/dist/docqa-spa/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|svg|gif|webp|woff|woff2|ttf|eot))",
      "dest": "frontend/dist/docqa-spa/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/docqa-spa/index.html"
    }
  ]
}