{
  "storage_path": "~/.rag-assistant",
  "retrieval": {
    "similarity_threshold": 0.3,
    "default_k": 5,
    "max_k": 20
  },
  "chunking": {
    "default_chunk_size": 700,
    "min_chunk_size": 100,
    "overlap_tokens": 50
  },
  "embedding": {
    "batch_size": 16,
    "normalize": true
  },
  "generation": {
    "temperature": 0.2,
    "max_output_tokens": 2048,
    "show_sources": false
  },
  "gemini": {
    "embedding_model": "text-embedding-004",
    "generation_model": "gemini-3-flash-preview",
    "available_models": {
      "embedding": [
        "text-embedding-004",
        "embedding-001"
      ],
      "generation": [
        "gemini-3-flash-preview",
        "gemini-1.5-flash",
        "gemini-1.5-pro"
      ]
    }
  },
  "openai": {
    "embedding_model": "text-embedding-3-small",
    "generation_model": "gpt-4o-mini",
    "available_models": {
      "embedding": [
        "text-embedding-3-small",
        "text-embedding-3-large",
        "text-embedding-ada-002"
      ],
      "generation": [
        "gpt-4o-mini",
        "gpt-4o",
        "gpt-4-turbo",
        "gpt-3.5-turbo"
      ]
    }
  },
  "groq": {
    "generation_model": "llama-3.1-8b-instant",
    "available_models": [
      "llama-3.1-8b-instant",
      "llama3-groq-70b-8192-tool-use-preview",
      "mixtral-8x7b-32768",
      "gemma2-9b-it"
    ],
    "api_url": "https://api.groq.com/openai/v1/chat/completions"
  },
  "local_llm": {
    "enabled": false,
    "note": "GPT4All disabled due to slow performance and stability issues"
  }
}
