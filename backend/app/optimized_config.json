      "connection_pool_size": 10
    },
    "openai": {
      "max_retries": 3,
      "retry_delay": 1.0,
      "timeout": 30.0,
      "batch_size": 100,
      "rate_limit_delay": 0.1,
      "connection_pool_size": 10
    }
  },
  "local_llm": {
    "enhanced_prompts": true,
    "adaptive_parameters": true,
    "post_processing": true,
